<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="80dp"
    android:viewportWidth="400"
    android:viewportHeight="80">

    <!-- Glow fill spilling downward from the curve -->
    <path
        android:pathData="M0,55 Q200,0 400,55 L400,80 L0,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="200"
                android:startY="20"
                android:endX="200"
                android:endY="80"
                android:type="linear">
                <item android:color="#6600FF88" android:offset="0.0" />
                <item android:color="#2200FF88" android:offset="0.5" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glow bloom (wide, faint) -->
    <path
        android:pathData="M0,55 Q200,0 400,55"
        android:strokeWidth="12"
        android:strokeColor="#1500FF66"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Glow mid layer -->
    <path
        android:pathData="M0,55 Q200,0 400,55"
        android:strokeWidth="7"
        android:strokeColor="#4400FF88"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Glow inner layer -->
    <path
        android:pathData="M0,55 Q200,0 400,55"
        android:strokeWidth="3.5"
        android:strokeColor="#9900EE77"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

    <!-- Bright core line -->
    <path
        android:pathData="M0,55 Q200,0 400,55"
        android:strokeWidth="1.5"
        android:strokeColor="#FF44FF99"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />

</vector>